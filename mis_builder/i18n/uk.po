msgstr "Стовпець %s не можна порівнювати з itrec."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance.py:0
msgid "Column %s with move lines source must have from/to dates."
msgstr "Стовпець %s із джерелом рядків переміщення повинен мати дати від/до."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/kpimatrix.py:0
msgid "Columns %(descr)s and %(base_descr)s are not comparable"
msgstr "Стовпці %(descr)s і %(base_descr)s не можна порівнювати"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance.py:0
msgid "Columns to compare must belong to the same report in %s"
msgstr "Стовпці для порівняння мають належати одному звіту в %s"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/report/mis_report_instance_xlsx.py:0
msgid "Generated on %(gen_date)s at %(gen_time)s"
msgstr "Згенеровано %(gen_date)s о %(gen_time)s"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/aep.py:0
msgid ""
"If currency_id is not provided, all companies must have the same currency."
msgstr ""
"Якщо currency_id не задано, усі компанії повинні мати однакову валюту."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_style.py:0
msgid "Indent level must be greater than or equal to 0"
msgstr "Рівень відступу має бути більшим або дорівнювати 0"

#. module: mis_builder
#. odoo-javascript
#: code:addons/mis_builder/static/src/annotation_dialog/annotation_dialog.xml:0
msgid "Insert note here"
msgstr "Вставте примітку тут"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report.py:0
msgid ""
"KPI \"%(kpi)s\" has type %(type)s while a tuple was expected.\n"
"\n"
"This can be fixed by either:\n"
"\t- Changing the KPI value to a tuple of length %(length)s\n"
"or\n"
"\t- Changing the KPI to `multi` mode and giving an explicit value for each sub-KPI."
msgstr ""
"KPI «%(kpi)s» має тип %(type)s, хоча очікувався кортеж.\n"
"\n"
"Це можна виправити одним зі способів:\n"
"\t- змінити значення KPI на кортеж довжини %(length)s\n"
"або\n"
"\t- перевести KPI в режим `multi` та задати явне значення для кожного під-KPI."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report.py:0
msgid ""
"KPI \"%(kpi)s\" is valued as a tuple of length %(length)s while a tuple of "
"length%(expected_length)s is expected."
msgstr ""
"KPI «%(kpi)s» має значення кортежу довжини %(length)s, тоді як очікується "
"кортеж довжини %(expected_length)s."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report.py:0
msgid "KPI name (%s) must be a valid python identifier"
msgstr "Назва KPI (%s) має бути дійсним ідентифікатором Python"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance.py:0
msgid "No date filter is allowed for this source in column %s."
msgstr "Для цього джерела у стовпці %s фільтр дати не дозволений."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance.py:0
msgid "Please provide both columns to compare in %s."
msgstr "Вкажіть обидва стовпці для порівняння в %s."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance.py:0
msgid ""
"Please select a report template and/or save the report before adding "
"columns."
msgstr ""
"Виберіть шаблон звіту та/або збережіть звіт перед додаванням стовпців."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report.py:0
msgid "Query name (%s) must be valid python identifier"
msgstr "Назва запиту (%s) має бути дійсним ідентифікатором Python"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report.py:0
msgid "Sub-KPI name (%s) must be a valid python identifier"
msgstr "Назва під-KPI (%s) має бути дійсним ідентифікатором Python"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_subreport.py:0
msgid "Subreport loop detected"
msgstr "Виявлено цикл підзвіту"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_subreport.py:0
msgid "Subreport name (%s) must be a valid python identifier"
msgstr "Назва підзвіту (%s) має бути дійсним ідентифікатором Python"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/kpimatrix.py:0
msgid ""
"Sum cannot be computed in column %s because the columns to sum have no "
"common subkpis"
msgstr ""
"Суму не можна обчислити у стовпці %s, оскільки стовпці для підсумовування не"
" мають спільних subkpi"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_kpi_data.py:0
msgid "Unexpected accumulation method %(method)s for %(name)s."
msgstr "Неочікуваний метод накопичення %(method)s для %(name)s."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report.py:0
msgid "Unexpected value %s for target_move."
msgstr "Неочікуване значення %s для target_move."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/prorata_read_group_mixin.py:0
msgid "Unsupported operator %s for searching on date"
msgstr "Непідтримуваний оператор %s для пошуку за датою"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance.py:0
msgid "You cannot sum period %s with itself."
msgstr "Ви не можете підсумувати період %s із самим собою."

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance_annotation.py:0
msgid "You do not have the rights to edit annotations"
msgstr "У вас немає прав редагувати анотації"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/aep.py:0
msgid "`%(field)s` cannot have a field name in expression %(expr)s"
msgstr "`%(field)s` не може мати назву поля у виразі %(expr)s"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/aep.py:0
msgid "`fld` can only be used with mode `p` (variation) in expression %s"
msgstr "`fld` можна використовувати лише з режимом `p` (варіація) у виразі %s"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/aep.py:0
msgid "`fld` must have a field name in exression %s"
msgstr "`fld` має містити назву поля у виразі %s"

#. module: mis_builder
#. odoo-python
#: code:addons/mis_builder/models/mis_report_instance.py:0
msgid "from %(date_from)s to %(date_to)s"
msgstr "з %(date_from)s до %(date_to)s"
